<?xml version="1.0" encoding="utf-8"?>
<com.example.simple.manymanager.HomePageLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView android:id="@+id/homeTitle" style="@style/Text"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/home_title" android:textSize="38sp"
        android:textStyle="bold" android:letterSpacing="-0.03"
        android:accessibilityHeading="true" />

    <LinearLayout android:id="@+id/homeExpenseActions"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:orientation="horizontal"
        android:baselineAligned="false">
        <LinearLayout android:id="@+id/addExpense"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:minHeight="72dp" android:padding="12dp" android:layout_marginEnd="6dp"
            android:background="@drawable/button_add_expense" android:orientation="vertical"
            android:gravity="center" android:clickable="true" android:focusable="true">
            <TextView style="@style/Text" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:text="@string/add_expense" android:textSize="15sp"
                android:textColor="@color/white" android:textStyle="bold" />
            <TextView style="@style/Text" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:text="@string/main_calculator" android:textSize="14sp"
                android:textColor="@color/white" />
        </LinearLayout>
        <LinearLayout android:id="@+id/addSecondExpense"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:minHeight="72dp" android:padding="12dp" android:layout_marginStart="6dp"
            android:background="@drawable/button_add_expense" android:orientation="vertical"
            android:gravity="center" android:clickable="true" android:focusable="true">
            <TextView style="@style/Text" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:text="@string/add_expense" android:textSize="15sp"
                android:textColor="@color/white" android:textStyle="bold" />
            <TextView style="@style/Text" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:text="@string/second_calculator" android:textSize="14sp"
                android:textColor="@color/white" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout android:id="@+id/homeOrnamentSpace"
        android:layout_width="match_parent" android:layout_height="176dp"
        android:layout_weight="1" android:paddingTop="36dp" android:paddingBottom="36dp"
        android:importantForAccessibility="noHideDescendants">
        <com.example.simple.manymanager.HomeOrnamentView android:id="@+id/homeOrnament"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="center" android:scaleType="fitCenter"
            app:srcCompat="@drawable/home_ornament" app:tint="@color/home_ornament"
            android:contentDescription="@null" android:focusable="false"
            android:clickable="false" android:importantForAccessibility="no" />
    </FrameLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">
        <include android:id="@+id/homeSummaryCard" layout="@layout/home_summary" />
        <include android:id="@+id/homeSecondSummaryCard" layout="@layout/home_summary"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />
    </LinearLayout>
</com.example.simple.manymanager.HomePageLayout>
